# TestSetu environment variables
#
# MongoDB-only production target:
# Frontend/domain: Cloudflare
# Backend/API: Render
# Primary database/storage: MongoDB Cluster 1
# Future secondary database/storage: MongoDB Cluster 2
# Uploaded files/images: MongoDB GridFS on the selected cluster

###############################################################################
# Render / Node.js backend
###############################################################################

NODE_ENV=production
PORT=4000

# Public frontend URL. Used for certificate QR/verification links and CORS.
FRONTEND_URL=https://testsetu.example.com
APP_URL=https://testsetu.example.com

# Required primary MongoDB cluster.
MONGODB_CLUSTER_1_URI=mongodb+srv://user:password@cluster1.example.mongodb.net/testsetu

# Optional future secondary MongoDB cluster. Missing/disabled Cluster 2 must not
# break the app.
MONGODB_CLUSTER_2_URI=
MONGODB_CLUSTER_2_ENABLED=false

# Required in production for signed auth tokens.
AUTH_SECRET=replace-with-a-long-random-secret

# One-time Super Admin setup token.
SETUP_TOKEN=replace-with-a-one-time-admin-setup-token

# Optional: only used by `npm run seed`.
SEED_SUPER_ADMIN_EMAIL=admin@testsetu.local
SEED_SUPER_ADMIN_PASSWORD=change-this-before-production

# Optional: only used by `npm run migrate:sqlite-to-mongo`.
SQLITE_MIGRATION_SOURCE=.data/testsetu.db

###############################################################################
# Cloudflare frontend/domain
###############################################################################

# Cloudflare Worker proxy uses this to forward /api and /uploads to Render.
BACKEND_ORIGIN=https://testsetu-backend.onrender.com

# If you deploy the frontend as plain static assets without the Worker proxy,
# set this public Vite variable to the Render backend URL.
VITE_API_URL=https://testsetu-backend.onrender.com

# If you later wrap this app in Next.js, use this equivalent public variable.
NEXT_PUBLIC_API_URL=https://testsetu-backend.onrender.com

# Cloudflare Pages/Workers binds ASSETS automatically from wrangler.toml.
# ASSETS is not a secret and does not need a manual value here.
